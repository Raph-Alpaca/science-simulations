{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Simulation metadata v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion","id","title","grade","unit","summary","concepts","schoolYear","curriculumRevision","entry","sourceIds","stage","assumptions","approvalIsExternal"],
  "properties": {
    "schemaVersion": {"const":1},
    "id": {"type":"string","maxLength":64,"pattern":"^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$"},
    "title": {"$ref":"#/definitions/short"},
    "grade": {"enum":[1,2,3]},
    "unit": {"$ref":"#/definitions/short"},
    "summary": {"type":"string","minLength":1,"maxLength":500,"pattern":"\\S"},
    "concepts": {"type":"array","minItems":1,"maxItems":20,"uniqueItems":true,"items":{"$ref":"#/definitions/short"}},
    "schoolYear": {"type":["integer","null"],"minimum":1900,"maximum":2200},
    "curriculumRevision": {"anyOf":[{"$ref":"#/definitions/short"},{"type":"null"}]},
    "entry": {"type":"string","minLength":1,"maxLength":200},
    "sourceIds": {"type":"array","minItems":1,"maxItems":30,"uniqueItems":true,"items":{"$ref":"#/definitions/short"}},
    "stage": {"enum":["draft","in_review","ready","withdrawn"]},
    "assumptions": {"type":"array","minItems":1,"maxItems":30,"items":{"$ref":"#/definitions/short"}},
    "approvalIsExternal": {"const":true},
    "note": {"type":"string","maxLength":1000}
  },
  "definitions": {"short":{"type":"string","minLength":1,"maxLength":150,"pattern":"\\S"}}
}
