# Copy to apps/studio/.env.local; never commit actual values.
# Phase 06 Vercel: enter only these six variables, Production only, after approval.
# Preview: no production keys; STUDIO_DB_READY=false. See docs/VERCEL_PREPARATION.md.
# AI_EXECUTION_ENABLED/AUTO_PUBLISH are future policy flags, not read by this mock-only app.
# Never copy the PC-only NODE_USE_SYSTEM_CA setting to Vercel.
# Supabase project Connect dialog / Settings > API Keys
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Server only. Never use a NEXT_PUBLIC_ prefix.
SUPABASE_SECRET_KEY=
# Authentication > Users: comma-separated approved teacher UUIDs
ALLOWED_USER_IDS=
# Local URL: http://127.0.0.1:3000 (enter manually)
STUDIO_ORIGIN=
# Set true only after approved SQL + permissions have been applied and checked.
STUDIO_DB_READY=false
