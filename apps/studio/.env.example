# Copy to apps/studio/.env.local; never commit actual values.
# Phase 06 Vercel: enter only these six variables, Production only, after approval.
# Preview: no production keys; STUDIO_DB_READY=false. See docs/VERCEL_PREPARATION.md.
# AI_EXECUTION_ENABLED/AUTO_PUBLISH are future policy flags, not read by this mock-only app.
# Never copy the PC-only NODE_USE_SYSTEM_CA setting to Vercel.
# Supabase project Connect dialog / Settings > API Keys
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Server only. Never use a NEXT_PUBLIC_ prefix.
SUPABASE_SECRET_KEY=
# Authentication > Users: comma-separated approved teacher UUIDs
ALLOWED_USER_IDS=
# Local URL: http://127.0.0.1:3000 (enter manually)
STUDIO_ORIGIN=
# Set true only after approved SQL + permissions have been applied and checked.
STUDIO_DB_READY=false
# Future worker report API. Keep disabled until worker SQL, workflow SHA and OIDC verification are deployed.
# Exact reviewed 40-character commit SHA(s), maximum two during a reviewed rollout.
STUDIO_WORKER_API_ENABLED=false
STUDIO_WORKER_TRUSTED_SHAS=
# Input preparation/consent only; requires reviewed input SQL. Does not start AI.
STUDIO_INPUT_REVIEW_ENABLED=false
# Server dispatch only. Requires reviewed SQL, deployed workflows, App installation
# scoped to this repository (Actions write + Contents read), and all worker gates.
# Never expose this private key to the browser or a GitHub generation job.
STUDIO_DISPATCH_ENABLED=false
STUDIO_GITHUB_APP_CLIENT_ID=
STUDIO_GITHUB_INSTALLATION_ID=
STUDIO_GITHUB_APP_PRIVATE_KEY=
# Private result/feedback screen only. Does not approve, retry or publish.
STUDIO_RESULT_REVIEW_ENABLED=false
# Follow-up revisions require reviewed revision SQL, input/result review, and fresh consent.
STUDIO_REVISION_ENABLED=false
